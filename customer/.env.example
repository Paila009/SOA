# Copy to customer/.env. Never commit the filled file or share secret keys in chat.
APP_ENV=development
CUSTOMER_HOST=127.0.0.1
CUSTOMER_PORT=8770
PUBLIC_ORIGIN=http://127.0.0.1:8770
# In production: APP_ENV=production, PUBLIC_ORIGIN=https://your-domain.example
# CUSTOMER_HOST=0.0.0.0 behind a HTTPS reverse proxy. One worker + persistent disk.

# Firebase web config (public identifiers, NOT service-account credentials)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Absolute path outside the repository to a Firebase Admin service-account JSON.
# Alternatively use Application Default Credentials on your hosting platform.
GOOGLE_APPLICATION_CREDENTIALS=

# Installed GGUF models appear in the same customer chat. They run on the server
# computer through llama.cpp; a public visitor needs a local companion app for
# true on-device execution on their own machine.
ENABLE_LOCAL_MODELS=true

# Optional API models. Keys stay on the server and are never sent to the browser.
# Check your Groq organization is on the FREE plan before changing this to true.
# This is YOUR confirmation, not automatic billing verification. Do not upgrade.
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_API_KEY=
# Copy an available chat model ID from your Groq Free Plan console.
# No default: model availability changes. Comma-separated IDs are supported.
GROQ_MODELS=
# Gemini is enabled only after the owner confirms that the selected project/model
# is using the Free Tier. Create a restricted Gemini key in Google AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
# Enter a currently available Gemini API model ID from your provider console.
GEMINI_MODELS=
# OpenRouter is restricted to model IDs ending in :free.
OPENROUTER_FREE_ONLY_CONFIRMED=false
OPENROUTER_API_KEY=
# Enter model IDs from your OpenRouter account, comma-separated.
OPENROUTER_MODELS=
# Optional provider:model-id from the configured list, otherwise selected chat model.
REVIEW_MODEL=

# Each research answer can use TWO API requests from the shared free quota.
# A paid account can still incur charges. The app cannot verify your billing plan.
DAILY_REQUESTS_PER_USER=30
DAILY_REQUESTS_TOTAL=200
MAX_CONCURRENT_REQUESTS=4
MAX_OUTPUT_TOKENS=1400
# Private chats, documents and reviews live here. Mount persistent storage in prod.
CUSTOMER_DB=outputs/customer/workspace.sqlite3
